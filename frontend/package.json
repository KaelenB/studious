{
  "name": "@studious/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "predev": "npm run build --workspace @studious/api",
    "dev": "vite",
    "prebuild": "npm run build --workspace @studious/api",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build --workspace @studious/api",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "pretest": "npm run build --workspace @studious/api",
    "test": "vitest run src",
    "pretest:e2e": "npm run build --workspace @studious/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@studious/api": "0.6.0",
    "@sveltestrap/sveltestrap": "7.1.0",
    "bootstrap": "5.3.8"
  }
}
