{
  "name": "@studious/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "predev": "npm run build --workspace @studious/api",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "prebuild": "npm run build --workspace @studious/api",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "pretypecheck": "npm run build --workspace @studious/api",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace @studious/api",
    "test": "vitest run --exclude \"api/**\"",
    "predb:generate": "npm run build --workspace @studious/api",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs",
    "predb:migrate": "npm run build --workspace @studious/api",
    "db:migrate": "tsx --disable-warning=ExperimentalWarning src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@studious/api": "0.8.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pdf-parse": "2.4.5",
    "read-excel-file": "9.3.14",
    "zod": "4.6.7"
  }
}
