# SQLite database file (created on first start). Its size is capped at DATABASE_MAX_BYTES
# (default and maximum 1073741824 = 1 GiB); writes beyond the cap return HTTP 507.
DATABASE_PATH=./data/studious.sqlite
DATABASE_MAX_BYTES=1073741824
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated exact browser origins allowed to call the API. Leave empty for
# same-origin/proxy setups. For the GitHub Pages site use https://kaelenb.github.io
CORS_ORIGINS=