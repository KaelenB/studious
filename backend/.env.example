DATABASE_URL=postgresql://studious:studious_local@localhost:5432/studious
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated exact browser origins allowed to call the API, e.g. a GitHub Pages
# frontend: https://your-user.github.io. Leave empty for same-origin/proxy setups.
CORS_ORIGINS=

# Local Docker Compose database credentials only; replace before shared use.
POSTGRES_USER=studious
POSTGRES_PASSWORD=studious_local
POSTGRES_DB=studious
POSTGRES_PORT=5432
